{
  "name": "handy-pos",
  "version": "1.0.0",
  "private": true,
  "description": "HandyPOS - Point of Sale System (Tauri Desktop)",
  "scripts": {
    "dev": "npm run dev:next",
    "dev:next": "next dev -p 3000",
    "dev:tauri": "tauri dev",
    "dev:django": "cd backend && python manage.py runserver 127.0.0.1:8000",
    "dev:all": "concurrently \"npm run dev:django\" \"npm run dev:tauri\"",
    "build": "next build",
    "tauri": "tauri",
    "build:tauri": "tauri build",
    "build:tauri:bundle": "npm run build && tauri build",
    "tauri:build:linux": "tauri build --config src-tauri/tauri.linux.conf.json",
    "tauri:build:deb": "npm run tauri:build:linux",
    "tauri:build:windows": "tauri build",
    "tauri:build:windows:x64": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:android:init": "bash scripts/tauri-android.sh init --ci --skip-targets-install",
    "tauri:android:signing:setup": "bash scripts/android-signing-setup.sh",
    "tauri:android:dev": "bash scripts/tauri-android.sh dev",
    "tauri:android:run": "bash scripts/tauri-android.sh run --release",
    "tauri:android:build": "bash scripts/android-signing-setup.sh && bash scripts/tauri-android.sh build --apk --aab",
    "tauri:android:build:apk": "bash scripts/android-signing-setup.sh && bash scripts/tauri-android.sh build --apk",
    "tauri:android:build:apk:split": "bash scripts/android-signing-setup.sh && bash scripts/tauri-android.sh build --apk --split-per-abi",
    "preview": "next start",
    "lint": "next lint"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.7",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.7",
    "dexie-react-hooks": "^1.1.7",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^2.5.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.35",
    "papaparse": "^5.4.1",
    "patch-package": "^8.0.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-qr-code": "^2.0.21",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.0",
    "zod": "^3.24.2"
  }
}
